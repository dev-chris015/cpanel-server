# Puerto del servidor backend Express / Socket.io
PORT=5000
NODE_ENV=development

# Credenciales de Administrador para inicio de sesión en cPanel
ADMIN_USER=superadmin
ADMIN_PASS=nara5140

# Clave secreta para firmar tokens JWT (Cambiar en producción)
JWT_SECRET=cpanel-secret-key-change-in-production

# Ruta al socket UNIX de Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Configuración de base de datos MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=

# Configuración del proxy inverso Nginx y Virtual Hosts
NGINX_VHOSTS_DIR=/etc/nginx/conf.d
NGINX_CONTAINER_NAME=cpanel-frontend

# Telemetría de host (Netdata con fallback a systeminformation)
NETDATA_URL=http://netdata:19999

# Copias de seguridad de bases de datos
BACKUP_DIR=/srv/backups
MARIADB_CONTAINER_NAME=wordpress_org_db
